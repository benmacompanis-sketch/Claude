---
permalink: /site.webmanifest
eleventyExcludeFromCollections: true
---
{
  "name": {{ site.nombre | plano | dump | safe }},
  "short_name": {{ site.nombreCorto | plano | dump | safe }},
  "description": {{ site.descriptor | dump | safe }},
  "lang": "es-AR",
  "start_url": "/",
  "display": "browser",
  "background_color": "#F9F5EE",
  "theme_color": "#F9F5EE",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" }
  ]
}
