<!doctype html>
<html lang="es-AR" class="no-js{% if site.borrador.resaltarProvisorios %} con-provisorios{% endif %}">
<head>
{% include "partials/head.njk" %}
</head>
<body class="pagina-{{ paginaId or 'general' }}">
  <a class="skip-link" href="#contenido">Saltar al contenido</a>
  {% include "partials/header.njk" %}
  <main id="contenido" tabindex="-1">
    {{ content | safe }}
  </main>
  {% include "partials/footer.njk" %}
  {% if site.whatsapp.botonFlotante and not sinFlotante %}{% include "partials/whatsapp-flotante.njk" %}{% endif %}
  <script type="module" src="{% asset 'js' %}"></script>
</body>
</html>
